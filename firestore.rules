rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function validTask(data) {
      return data.keys().hasOnly([
          "task", "code", "userStory", "userStoryId", "userStoryDescription", "pi", "piId", "sprint", "sprintId", "feature", "featureId", "assignee", "assigneeUid",
          "storyPoints", "priority", "startDate", "endDate", "description",
          "status", "archived", "createdBy", "createdAt", "updatedAt", "subtasks", "dependencies", "acceptanceCriteria", "userStoryStatus"
        ])
        && data.task is string && data.task.size() > 0 && data.task.size() <= 160
        && (!data.keys().hasAll(["code"]) || (data.code is string && data.code.matches("^TASK-[0-9]{3,}$")))
        && (!data.keys().hasAll(["sprintId"]) || (data.sprintId is string && data.sprintId.size() <= 100))
        && data.userStory is string
        && (!data.keys().hasAll(["userStoryId"]) || (data.userStoryId is string && data.userStoryId.size() <= 100))
        && data.pi is string && data.sprint is string
        && data.feature is string && data.assignee is string
        && (!data.keys().hasAll(["piId"]) || (data.piId is string && data.piId.size() <= 100))
        && (!data.keys().hasAll(["featureId"]) || (data.featureId is string && data.featureId.size() <= 100))
        && (!data.keys().hasAll(["assigneeUid"]) || data.assigneeUid is string)
        && data.storyPoints is number && data.storyPoints >= 0
        && data.priority is string && data.startDate is string && data.endDate is string
        && data.description is string && data.status in ["To Do", "In Progress", "Done"]
        && (!data.keys().hasAll(["archived"]) || data.archived is bool)
        && data.createdBy is string
        && (!data.keys().hasAll(["subtasks"]) || (data.subtasks is list && data.subtasks.size() <= 50))
        && (!data.keys().hasAll(["dependencies"]) || (data.dependencies is list && data.dependencies.size() <= 50))
        && (!data.keys().hasAll(["acceptanceCriteria"]) || (data.acceptanceCriteria is list && data.acceptanceCriteria.size() <= 50))
        && (!data.keys().hasAll(["userStoryStatus"]) || data.userStoryStatus in ["Draft", "Ready", "In Progress", "In Review", "Accepted"]);
    }

    function validUserStory(data) {
      return data.keys().hasOnly([
          "title", "code", "description", "acceptanceCriteria", "owner", "ownerUid", "pi", "piId", "feature", "featureId",
          "startDate", "endDate", "lifecycle", "createdBy", "createdAt", "updatedAt", "archived"
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && (!data.keys().hasAll(["code"]) || (data.code is string && data.code.matches("^US-[0-9]{3,}$")))
        && data.description is string && data.description.size() <= 1500
        && data.acceptanceCriteria is list && data.acceptanceCriteria.size() <= 50
        && data.pi is string && data.pi.size() <= 100
        && data.feature is string && data.feature.size() <= 120
        && (!data.keys().hasAll(["piId"]) || (data.piId is string && data.piId.size() <= 100))
        && (!data.keys().hasAll(["featureId"]) || (data.featureId is string && data.featureId.size() <= 100))
        && data.startDate is string && data.endDate is string
        && data.lifecycle in ["Draft", "Ready", "In Progress", "In Review", "Accepted"]
        && data.createdBy is string
        && (!data.keys().hasAll(["archived"]) || data.archived is bool);
    }

    function validNewTask(data) {
      return validTask(data)
        && data.keys().hasAll(["code", "archived"])
        && data.code.matches("^TASK-[0-9]{3,}$")
        && data.keys().hasAll(["archived"])
        && data.archived == false;
    }

    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/plannerProjects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isProjectMember(projectId) {
      return get(/databases/$(database)/documents/plannerProjects/$(projectId)).data.archived != true
        && (isProjectOwner(projectId)
          || exists(/databases/$(database)/documents/plannerProjects/$(projectId)/members/$(request.auth.uid)));
    }

    function canEditProject(projectId) {
      return get(/databases/$(database)/documents/plannerProjects/$(projectId)).data.archived != true
        && (isProjectOwner(projectId)
          || get(/databases/$(database)/documents/plannerProjects/$(projectId)/members/$(request.auth.uid)).data.role in ["owner", "editor"]);
    }

    match /plannerUsers/{uid} {
      allow create: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "firstName", "lastName", "createdAt", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow get: if isVerifiedUser() && request.auth.uid == uid;
      allow update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.diff(resource.data).affectedKeys().hasOnly(["firstName", "lastName", "displayName", "preferences", "updatedAt"]);
      allow list, delete: if false;
    }

    // Contains only display names and UIDs so project owners can search users by name.
    match /plannerDirectory/{uid} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "displayName", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 161;
      allow delete: if false;
    }

    match /plannerSequences/{entityType} {
      allow get: if isVerifiedUser();
      allow list: if false;
      allow create: if isVerifiedUser() && entityType in ["pi", "feature", "sprint", "story", "task"]
        && request.resource.data.keys().hasOnly(["entityType", "lastAllocated", "updatedAt"])
        && request.resource.data.entityType == entityType
        && request.resource.data.lastAllocated is int && request.resource.data.lastAllocated > 0;
      allow update: if isVerifiedUser() && request.resource.data.entityType == resource.data.entityType
        && request.resource.data.lastAllocated is int
        && request.resource.data.lastAllocated == resource.data.lastAllocated + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastAllocated", "updatedAt"]);
      allow delete: if false;
    }

    // Program Increment and Feature catalogue for the shared Default Project.
    match /plannerProgramIncrements/{piId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(["name", "code", "description", "startDate", "endDate", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.code is string && request.resource.data.code.matches("^PI-[0-9]{3,}$")
        && request.resource.data.description is string && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"]
        && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.code == resource.data.code
        && (!resource.data.keys().hasAll(["code"]) || request.resource.data.code == resource.data.code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "description", "startDate", "endDate", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    match /plannerFeatures/{featureId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(["name", "code", "piId", "pi", "description", "owner", "ownerUid", "priority", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.code is string && request.resource.data.code.matches("^FEAT-[0-9]{3,}$")
        && request.resource.data.piId is string && exists(/databases/$(database)/documents/plannerProgramIncrements/$(request.resource.data.piId))
        && request.resource.data.pi is string && request.resource.data.description is string
        && request.resource.data.owner is string && request.resource.data.priority in ["HIGH", "MEDIUM", "LOW"]
        && request.resource.data.status in ["PLANNED", "IN_PROGRESS", "COMPLETED"]
        && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.code == resource.data.code
        && (!resource.data.keys().hasAll(["code"]) || request.resource.data.code == resource.data.code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "piId", "pi", "description", "owner", "ownerUid", "priority", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.piId is string && exists(/databases/$(database)/documents/plannerProgramIncrements/$(request.resource.data.piId))
        && request.resource.data.pi is string && request.resource.data.description is string
        && request.resource.data.owner is string && request.resource.data.priority in ["HIGH", "MEDIUM", "LOW"]
        && request.resource.data.status in ["PLANNED", "IN_PROGRESS", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    match /plannerSprints/{sprintId} {
      allow get, list: if isVerifiedUser();
      match /dailySnapshots/{snapshotDate} {
        allow get, list: if isVerifiedUser();
        allow create, update: if isVerifiedUser()
          && request.resource.data.keys().hasOnly(["date", "sprintId", "sprintName", "projectId", "taskCount", "totalPoints", "completedPoints", "remainingPoints", "todoCount", "inProgressCount", "doneCount", "recordedBy", "recordedAt"])
          && request.resource.data.date == snapshotDate
          && request.resource.data.sprintId == sprintId
          && request.resource.data.projectId == "default"
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.taskCount is int && request.resource.data.taskCount >= 0
          && request.resource.data.totalPoints is number && request.resource.data.totalPoints >= 0
          && request.resource.data.completedPoints is number && request.resource.data.completedPoints >= 0
          && request.resource.data.remainingPoints is number && request.resource.data.remainingPoints >= 0
          && request.resource.data.todoCount is int && request.resource.data.inProgressCount is int && request.resource.data.doneCount is int;
        allow delete: if false;
      }
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(["name", "code", "goal", "startDate", "endDate", "capacity", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.code is string && request.resource.data.code.matches("^SPR-[0-9]{3,}$")
        && request.resource.data.goal is string && request.resource.data.goal.size() <= 1200
        && request.resource.data.startDate is string && request.resource.data.endDate is string && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.capacity is number && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"] && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser() && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "goal", "startDate", "endDate", "capacity", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.goal is string && request.resource.data.goal.size() <= 1200
        && request.resource.data.startDate is string && request.resource.data.endDate is string && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.capacity is number && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    // Standalone User Stories in the shared Default Project.
    match /plannerUserStories/{storyId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && validUserStory(request.resource.data)
        && request.resource.data.code is string && request.resource.data.code.matches("^US-[0-9]{3,}$")
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.featureId is string
        && exists(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId))
        && get(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId)).data.piId == request.resource.data.piId;
      allow update: if isVerifiedUser() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.keys().hasAll(["code"]) || request.resource.data.code == resource.data.code)
        && validUserStory(request.resource.data)
        && request.resource.data.featureId is string
        && exists(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId))
        && get(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId)).data.piId == request.resource.data.piId;
      allow delete: if isVerifiedUser() && resource.data.createdBy == request.auth.uid;
    }

    // Existing data remains the shared Default Project and is not migrated or overwritten.
    match /plannerTasks/{taskId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && validNewTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAll(["featureId"]) || request.resource.data.featureId == ""
          || (exists(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId))
            && get(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId)).data.piId == request.resource.data.piId));
      allow update: if isVerifiedUser() && (
        (request.resource.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["To Do", "In Progress", "Done"])
        || (resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && (!resource.data.keys().hasAll(["code"]) || request.resource.data.code == resource.data.code)
          && validTask(request.resource.data)
          && (!request.resource.data.keys().hasAll(["featureId"]) || request.resource.data.featureId == ""
            || (exists(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId))
              && get(/databases/$(database)/documents/plannerFeatures/$(request.resource.data.featureId)).data.piId == request.resource.data.piId)))
        || (resource.data.createdBy == request.auth.uid
          && request.resource.diff(resource.data).affectedKeys().hasOnly(["archived", "updatedAt"])
          && request.resource.data.archived is bool)
      );
      allow delete: if isVerifiedUser() && resource.data.createdBy == request.auth.uid;
    }

    match /plannerProjects/{projectId} {
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(["name", "description", "ownerId", "archived", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.archived == false;
      allow get, list: if isVerifiedUser()
        && (resource.data.ownerId == request.auth.uid || isProjectMember(projectId));
      allow update: if isVerifiedUser() && isProjectOwner(projectId)
        && request.resource.data.keys().hasOnly(["name", "description", "ownerId", "archived", "createdAt", "updatedAt"])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.archived is bool;
      // Parent-document deletion would leave Firestore subcollections behind.
      allow delete: if false;
    }

    match /plannerProjects/{projectId}/members/{memberId} {
      allow get: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isProjectOwner(projectId));
      allow list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && (
        (memberId == request.auth.uid && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "owner"
          && request.resource.data.displayName is string
          && request.resource.data.keys().hasOnly(["uid", "displayName", "role", "addedAt"])
          && getAfter(/databases/$(database)/documents/plannerProjects/$(projectId)).data.ownerId == request.auth.uid)
        || (isProjectOwner(projectId)
          && request.resource.data.uid == memberId
          && request.resource.data.keys().hasOnly(["uid", "displayName", "role", "addedAt"])
          && request.resource.data.role in ["editor", "viewer"]
          && request.resource.data.displayName is string)
      );
      allow update: if isVerifiedUser() && isProjectOwner(projectId)
        && memberId != get(/databases/$(database)/documents/plannerProjects/$(projectId)).data.ownerId
        && request.resource.data.keys().hasOnly(["uid", "displayName", "role", "addedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.role in ["editor", "viewer"];
      allow delete: if isVerifiedUser() && isProjectOwner(projectId)
        && memberId != get(/databases/$(database)/documents/plannerProjects/$(projectId)).data.ownerId;
    }

    match /plannerUserProjects/{uid}/projects/{projectId} {
      allow get, list: if isVerifiedUser() && request.auth.uid == uid;
      allow create: if isVerifiedUser() && request.resource.data.keys().hasOnly(["role", "addedAt"])
        && request.resource.data.role in ["owner", "editor", "viewer"]
        && (
          isProjectOwner(projectId)
          || (request.auth.uid == uid
            && request.resource.data.role == "owner"
            && getAfter(/databases/$(database)/documents/plannerProjects/$(projectId)).data.ownerId == request.auth.uid)
        );
      allow update: if isVerifiedUser() && isProjectOwner(projectId)
        && request.resource.data.keys().hasOnly(["role", "addedAt"])
        && request.resource.data.role in ["editor", "viewer"];
      allow delete: if isVerifiedUser()
        && (request.auth.uid == uid || isProjectOwner(projectId));
    }

    match /plannerProjects/{projectId}/sequences/{entityType} {
      allow get: if isVerifiedUser() && isProjectMember(projectId);
      allow list: if false;
      allow create: if isVerifiedUser() && canEditProject(projectId) && entityType in ["pi", "feature", "sprint", "story", "task"]
        && request.resource.data.keys().hasOnly(["entityType", "lastAllocated", "updatedAt"])
        && request.resource.data.entityType == entityType
        && request.resource.data.lastAllocated is int && request.resource.data.lastAllocated > 0;
      allow update: if isVerifiedUser() && canEditProject(projectId) && request.resource.data.entityType == resource.data.entityType
        && request.resource.data.lastAllocated is int
        && request.resource.data.lastAllocated == resource.data.lastAllocated + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastAllocated", "updatedAt"]);
      allow delete: if false;
    }

    // Project-scoped PI and Feature catalogue. Members may read; owners/editors may write.
    match /plannerProjects/{projectId}/programIncrements/{piId} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.keys().hasOnly(["name", "code", "description", "startDate", "endDate", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.code is string && request.resource.data.code.matches("^PI-[0-9]{3,}$")
        && request.resource.data.description is string && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"]
        && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "description", "startDate", "endDate", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    match /plannerProjects/{projectId}/features/{featureId} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.keys().hasOnly(["name", "code", "piId", "pi", "description", "owner", "ownerUid", "priority", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.code is string && request.resource.data.code.matches("^FEAT-[0-9]{3,}$")
        && request.resource.data.piId is string
        && exists(/databases/$(database)/documents/plannerProjects/$(projectId)/programIncrements/$(request.resource.data.piId))
        && request.resource.data.pi is string && request.resource.data.description is string && request.resource.data.owner is string
        && request.resource.data.priority in ["HIGH", "MEDIUM", "LOW"] && request.resource.data.status in ["PLANNED", "IN_PROGRESS", "COMPLETED"]
        && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "piId", "pi", "description", "owner", "ownerUid", "priority", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.piId is string
        && exists(/databases/$(database)/documents/plannerProjects/$(projectId)/programIncrements/$(request.resource.data.piId))
        && request.resource.data.pi is string && request.resource.data.description is string && request.resource.data.owner is string
        && request.resource.data.priority in ["HIGH", "MEDIUM", "LOW"] && request.resource.data.status in ["PLANNED", "IN_PROGRESS", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    match /plannerProjects/{projectId}/userStories/{storyId} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && canEditProject(projectId)
        && validUserStory(request.resource.data)
        && request.resource.data.code is string && request.resource.data.code.matches("^US-[0-9]{3,}$")
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.featureId is string
        && exists(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId))
        && get(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId)).data.piId == request.resource.data.piId;
      allow update: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.keys().hasAll(["code"]) || request.resource.data.code == resource.data.code)
        && validUserStory(request.resource.data)
        && request.resource.data.featureId is string
        && exists(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId))
        && get(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId)).data.piId == request.resource.data.piId;
      allow delete: if isVerifiedUser() && canEditProject(projectId);
    }

    match /plannerProjects/{projectId}/sprints/{sprintId} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.keys().hasOnly(["name", "code", "goal", "startDate", "endDate", "capacity", "status", "archived", "createdBy", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.code is string && request.resource.data.code.matches("^SPR-[0-9]{3,}$")
        && request.resource.data.goal is string && request.resource.data.goal.size() <= 1200
        && request.resource.data.startDate is string && request.resource.data.endDate is string && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.capacity is number && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"]
        && request.resource.data.archived is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.code == resource.data.code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "goal", "startDate", "endDate", "capacity", "status", "archived", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.goal is string && request.resource.data.goal.size() <= 1200
        && request.resource.data.startDate is string && request.resource.data.endDate is string && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.capacity is number && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
        && request.resource.data.status in ["PLANNED", "ACTIVE", "COMPLETED"] && request.resource.data.archived is bool;
      allow delete: if false;
    }

    match /plannerProjects/{projectId}/sprints/{sprintId}/dailySnapshots/{snapshotDate} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create, update: if isVerifiedUser() && canEditProject(projectId)
        && request.resource.data.keys().hasOnly(["date", "sprintId", "sprintName", "projectId", "taskCount", "totalPoints", "completedPoints", "remainingPoints", "todoCount", "inProgressCount", "doneCount", "recordedBy", "recordedAt"])
        && request.resource.data.date == snapshotDate
        && request.resource.data.sprintId == sprintId
        && request.resource.data.projectId == projectId
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.taskCount is int && request.resource.data.taskCount >= 0
        && request.resource.data.totalPoints is number && request.resource.data.totalPoints >= 0
        && request.resource.data.completedPoints is number && request.resource.data.completedPoints >= 0
        && request.resource.data.remainingPoints is number && request.resource.data.remainingPoints >= 0
        && request.resource.data.todoCount is int && request.resource.data.inProgressCount is int && request.resource.data.doneCount is int;
      allow delete: if false;
    }

    match /plannerProjects/{projectId}/tasks/{taskId} {
      allow get, list: if isVerifiedUser() && isProjectMember(projectId);
      allow create: if isVerifiedUser() && canEditProject(projectId)
        && validNewTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAll(["featureId"]) || request.resource.data.featureId == ""
          || (exists(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId))
            && get(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId)).data.piId == request.resource.data.piId));
      allow update: if isVerifiedUser() && canEditProject(projectId)
        && (
          (request.resource.data.createdBy == resource.data.createdBy
            && validTask(request.resource.data)
            && (!request.resource.data.keys().hasAll(["featureId"]) || request.resource.data.featureId == ""
              || (exists(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId))
                && get(/databases/$(database)/documents/plannerProjects/$(projectId)/features/$(request.resource.data.featureId)).data.piId == request.resource.data.piId)))
          || (request.resource.diff(resource.data).affectedKeys().hasOnly(["archived", "updatedAt"])
            && request.resource.data.archived is bool)
        );
      allow delete: if isVerifiedUser() && canEditProject(projectId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
